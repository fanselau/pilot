{
  "name": "@punchlab/pilot",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "pilot": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "description": "Autonomous AI development pipeline CLI — monitors, orchestrates, and manages AI coding agents",
  "keywords": [
    "ai",
    "development",
    "pipeline",
    "automation",
    "cli",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lucafanselau/pilot.git"
  },
  "author": "PunchLab <hello@punchlab.dev>",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"const f=require('fs');const c=f.readFileSync('dist/index.js','utf8');if(!c.startsWith('#!'))f.writeFileSync('dist/index.js','#!/usr/bin/env node\\n'+c);\" && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "ink": "^5.2.0",
    "nanoid": "^5.1.6",
    "ora": "^8.1.0",
    "picocolors": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
